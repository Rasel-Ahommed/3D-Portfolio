# ── Contact form ─────────────────────────────────────────────
# Configure ONE of these, then rebuild. With neither set, the form validates
# input but tells the visitor it isn't connected and offers a pre-filled email.

# Option A — the bundled PHP endpoint (server/contact.php) or any JSON endpoint (e.g. Formspree):
# VITE_CONTACT_ENDPOINT=/api/contact.php
# VITE_CONTACT_ENDPOINT=https://formspree.io/f/your-form-id

# Option B — Web3Forms access key (https://web3forms.com):
# VITE_WEB3FORMS_KEY=your-access-key

# ── Content review ───────────────────────────────────────────
# Draft projects/products and "Content needed" placeholders are always visible
# in `npm run dev`. Set these to true to also show them in a production build
# (e.g. on a private staging site).
# VITE_SHOW_DRAFTS=true
# VITE_SHOW_PLACEHOLDERS=true
